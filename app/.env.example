# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (web app).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Backend URL; in development it defaults to this PC's address on port 8080 (the same
# host Expo Go loads the app from), so a phone on the same Wi-Fi can reach it.
EXPO_PUBLIC_API_URL=
